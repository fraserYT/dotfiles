# Originally generated by nwg-displays on 2025-08-04; edited by hand 2026-09-21.
# Sourced from hyprland.conf via the yadm symlink monitors.conf -> monitors.conf##class.work.

# Laptop panel. Logical size at scale 1.2 is 2100x1400.
monitor=eDP-1,2520x1680@91.0,0x0,1.2

# Samsung ultrawide, centred above the laptop panel: x = (2100 - 3440) / 2 = -670.
# Matched by EDID description rather than connector because the dock lands it on
# DP-1 or DP-2 depending on which port is used; both must behave identically.
monitor=desc:Samsung Electric Company S34J55x H4LR700626,3440x1440@49.987,-670x-1440,1
