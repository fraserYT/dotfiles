#!/usr/bin/env bash
# bsb-sql: run SQL against the strategy database from a terminal (kitty, Midnight Commander).
# Made 25 Nov 2026.
#
#   bsb-sql run FILE.sql   show the file, ask y/N, run it with psql as ONE transaction
#                          (ON_ERROR_STOP + --single-transaction: any error rolls the whole file back)
#   bsb-sql ide            open Harlequin (terminal SQL editor + results grid) on the same database
#   bsb-sql check          `select 1`, to prove the connection works
#
# The connection: one postgres:// URL, the same value as STRATEGY_DB_URL in bsb-strategy-system's
# env file. It never sits on disk here or passes through Claude: ~/.config/bsb/strategy-db.env holds
# only a 1Password reference (STRATEGY_DB_URL=op://<vault>/<item>/<field>), and `op run` resolves it
# at run time, asking to unlock 1Password when needed (house rule: secrets via `op run`, never Claude).
# The URL is expanded inside the child shell, so it never appears in this script's arguments.
#
# Scratch files written for Drizzle Studio (no BEGIN/COMMIT) run unchanged here; files that do have
# their own BEGIN/COMMIT run too, though psql warns that a transaction is already in progress.
set -euo pipefail

LABEL="strategy"
ENV_FILE="${BSB_SQL_ENV:-$HOME/.config/bsb/strategy-db.env}"

die() { printf 'bsb-sql: %s\n' "$*" >&2; exit 1; }

preflight() {
  command -v op >/dev/null   || die "1Password CLI (op) not found"
  [[ -f "$ENV_FILE" ]]       || die "missing $ENV_FILE (one line: STRATEGY_DB_URL=op://<vault>/<item>/<field>)"
  # Accepts `export ` in front and a quoted value; the name must be upper case (it is read as
  # $STRATEGY_DB_URL below).
  # Editors add a byte-order mark or Windows line endings; strip both before checking.
  local clean
  clean=$(sed -e '1s/^\xEF\xBB\xBF//' -e 's/\r$//' "$ENV_FILE")
  if ! grep -qE '^[[:space:]]*(export[[:space:]]+)?STRATEGY_DB_URL=["'"'"']?op://' <<<"$clean"; then
    explain_env
    die "$ENV_FILE must set STRATEGY_DB_URL to an op:// reference, not the URL itself"
  fi
}

# Says what the file holds without printing any value: each line's name, the value's first five
# characters only when they are the public prefix "op://", and any hidden characters.
explain_env() {
  local n=0 line name val kind
  printf 'bsb-sql: what %s holds (values never shown):\n' "$ENV_FILE" >&2
  head -c3 "$ENV_FILE" | grep -q $'\xEF\xBB\xBF' && echo "  file starts with a byte-order mark (stripped)" >&2
  grep -q $'\r' "$ENV_FILE" && echo "  Windows line endings found (stripped)" >&2
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ -z "${line//[[:space:]]/}" ]] && { echo "  line $n: blank" >&2; continue; }
    [[ "$line" == \#* ]] && { echo "  line $n: comment" >&2; continue; }
    [[ "$line" != *=* ]] && { echo "  line $n: no '=' sign" >&2; continue; }
    name=${line%%=*}; val=${line#*=}; val=${val#[\"\']}
    if [[ "$name" == *[[:space:]] || "$val" == [[:space:]]* ]]; then kind="written with spaces round '=' (remove them)"
    elif [[ "$val" == op://* ]]; then kind="an op:// reference"
    elif [[ "$val" == postgres* ]]; then kind="a plain postgres URL (move it into 1Password)"
    elif [[ -z "$val" ]]; then kind="empty"
    else kind="something else (${#val} characters)"; fi
    printf '  line %d: name [%s], value is %s\n' "$n" "$name" "$kind" >&2
  done < "$ENV_FILE"
}

# Run a command with STRATEGY_DB_URL resolved by 1Password. "$@" is the command; the literal word
# URL in it is replaced by the resolved value inside the child shell, never on this command line.
#
# Which 1Password account: Dixie is signed in to more than one, and `op` refuses to guess. Set
# OP_ACCOUNT (the sign-in address from `op account list`, e.g. in ~/.zshrc), or BSB_SQL_OP_ACCOUNT
# to use a different one just for this script.
with_url() {
  local account="${BSB_SQL_OP_ACCOUNT:-${OP_ACCOUNT:-}}"
  [[ -n "$account" ]] || die "more than one 1Password account may be signed in: set OP_ACCOUNT (see \`op account list\`)"
  # The value as stored in 1Password may carry a leading space or newline, or the quotes it had in
  # an env file; psql then fails to see a URL ("invalid connection option", 25 Nov 2026). Trim both.
  op run --account "$account" --env-file="$ENV_FILE" -- bash -c '
    u=$STRATEGY_DB_URL
    u=${u#"${u%%[![:space:]]*}"}; u=${u%"${u##*[![:space:]]}"}
    sq=$(printf "\047")
    if [[ $u == \"*\" || $u == "$sq"*"$sq" ]]; then u=${u:1:${#u}-2}; fi
    [[ $u == postgres://* || $u == postgresql://* ]] || { echo "bsb-sql: the 1Password value does not start with postgresql:// (value not shown)" >&2; exit 1; }
    # The password leaves the URL and travels as PGPASSWORD, which libpq (psql, Harlequin) reads and
    # never prints. In the URL it showed in full in a psql error (25 Nov 2026) and in `ps` to every
    # process on the machine. URL percent-encoding is decoded first, as libpq would.
    scheme=${u%%://*}; rest=${u#*://}; auth=${rest%%@*}
    if [[ $rest == *@* && $auth == *:* ]]; then
      pw=${auth#*:}
      export PGPASSWORD="$(printf "%b" "${pw//%/\\x}")"
      u="$scheme://${auth%%:*}@${rest#*@}"
    fi
    unset STRATEGY_DB_URL pw auth rest
    args=(); for a in "$@"; do if [[ "$a" == URL ]]; then args+=("$u"); else args+=("$a"); fi; done
    exec "${args[@]}"' bsb-sql "$@"
}

case "${1:-}" in
  run)
    file="${2:-}"
    [[ -f "$file" && "$file" == *.sql ]] || die "usage: bsb-sql run FILE.sql"
    preflight
    command -v psql >/dev/null || die "psql not found"
    ${PAGER:-less} "$file"
    printf '\nRun %s on the LIVE %s database (one transaction)? [y/N] ' "$(basename "$file")" "$LABEL"
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]] || { echo "Not run."; exit 0; }
    with_url psql URL -v ON_ERROR_STOP=1 --single-transaction -f "$file"
    ;;
  ide)
    preflight
    command -v harlequin >/dev/null || die "harlequin not installed (pipx install harlequin harlequin-postgres)"
    with_url harlequin -a postgres URL
    ;;
  check)
    preflight
    with_url psql URL -c "select 1 as connected"
    ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
